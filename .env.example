# Copy to .env.local and enter the credentials from your email provider.
# These values are server-only. Never use NEXT_PUBLIC_ for SMTP credentials.
SMTP_HOST=
# Use 587 for STARTTLS or 465 for implicit TLS.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Use an address your SMTP provider has authorized to send mail.
SMTP_FROM="Grow Dart <hi@growdart.com>"
